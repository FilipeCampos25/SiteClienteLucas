# development (default) or production
APP_ENV=development

# Enable only when requests arrive through a proxy controlled by you, such as
# the Nginx configuration in deploy/hostinger/sitecliente.nginx.conf.
TRUST_PROXY_HEADERS=false

# Development can leave DATABASE_URL empty and use sqlite:///./local.db.
# Production must use a PostgreSQL URL, either local to the VPS or external.
DATABASE_URL=

# Development defaults are allowed with warnings.
# Production requires explicit, non-default values.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-long-random-secret

# Development may use "*". Production requires explicit comma-separated origins
# and never accepts "*", for example:
# CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=*

# Public site settings
WHATSAPP_NUMERO=
INSTAGRAM_URL=
FACEBOOK_URL=
STORE_ADDRESS=Rua 08, Chacara 225, Loja 2/3, Vicente Pires, Brasilia - DF, CEP 72007-065
STORE_CNPJ=55.291.020/0001-50

# Maximum upload size in bytes. Default: 4 MB.
MAX_IMAGE_BYTES=4000000
