[Unit]
Description=SiteClienteLucas FastAPI application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sitecliente
Group=www-data
WorkingDirectory=/opt/sitecliente
EnvironmentFile=/etc/sitecliente/sitecliente.env
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/opt/sitecliente/.venv/bin/alembic upgrade head
ExecStart=/opt/sitecliente/.venv/bin/gunicorn main:app \
    --workers 2 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -

Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGQUIT
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
